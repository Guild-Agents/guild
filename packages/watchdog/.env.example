# Guild Watchdog — Environment Variables
# Copy to .env and fill in values: cp .env.example .env

# GitHub — required for CI + PR sensors
GITHUB_TOKEN=           # Personal access token (or use: $(gh auth token))
GITHUB_OWNER=Guild-Agents
GITHUB_REPO=guild

# Anthropic — required for LLM triage (Haiku) and action (Sonnet)
ANTHROPIC_API_KEY=

# Telegram — required for notifications and bot commands
TELEGRAM_BOT_TOKEN=     # From @BotFather
TELEGRAM_CHAT_ID=       # Your chat/group ID

# Optional
# WATCHDOG_WORKSPACE_PATH=workspace
